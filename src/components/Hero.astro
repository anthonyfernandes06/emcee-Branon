---
import HandArrow from "./HandArrow.astro";
import { hero, alt, images, type NotePlacement } from "../content/site";
import { heroSources, DESKTOP_MEDIA, MOBILE_MEDIA } from "../lib/hero";
import { withBase } from "../lib/paths";

const { desktop, mobile, poster } = await heroSources();
const altText = alt[hero.photo.image] ?? "";
const focalMobile = (hero.photoMobile ?? hero.photo).focal ?? "50% 30%";

/** CSS variables that place the note and aim its arrow for one breakpoint (m or d). */
function noteVars(bp: string, { x, y, arrow }: NotePlacement) {
  const up = arrow.startsWith("up");
  const right = arrow.endsWith("right");
  return [
    `--n-${bp}-x: ${x}`,
    `--n-${bp}-y: ${y}`,
    // The arrow is drawn tail bottom-left, tip top-right; flip it to face the other ways.
    `--a-${bp}-top: ${up ? "auto" : "calc(100% + 2px)"}`,
    `--a-${bp}-bottom: ${up ? "calc(100% + 2px)" : "auto"}`,
    `--a-${bp}-left: ${right ? (up ? "38%" : "48%") : "auto"}`,
    `--a-${bp}-right: ${right ? "auto" : up ? "38%" : "52%"}`,
    `--a-${bp}-transform: ${up ? (right ? "rotate(4deg)" : "scaleX(-1) rotate(4deg)") : right ? "scaleY(-1)" : "rotate(180deg)"}`,
  ].join("; ");
}

/** The photo's shape and focal point, so the note's frame can match object-fit: cover exactly. */
function frameVars(bp: string, key: string, focal = "50% 50%") {
  const img = images[key];
  const [fx, fy = "50%"] = focal.split(/\s+/);
  return [`--ratio-${bp}: ${img.width} / ${img.height}`, `--fx-${bp}: ${fx}`, `--fy-${bp}: ${fy}`].join("; ");
}

const mobilePhoto = hero.photoMobile ?? hero.photo;
const cardStyle = [
  `--focal-d: ${hero.photo.focal ?? "50% 30%"}`,
  `--focal-m: ${focalMobile}`,
  frameVars("d", hero.photo.image, hero.photo.focal),
  frameVars("m", mobilePhoto.image, mobilePhoto.focal),
  noteVars("d", hero.notePosition.desktop),
  noteVars("m", hero.notePosition.mobile),
].join("; ");
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class:list={["hero__card", `hero__card--text-${hero.textSide}`]} style={cardStyle}>
    <div class="hero__media">
      <picture>
        {mobile && <source media={MOBILE_MEDIA} type="image/avif" srcset={mobile.avif} sizes={mobile.sizes} />}
        {mobile && <source media={MOBILE_MEDIA} type="image/webp" srcset={mobile.webp} sizes={mobile.sizes} />}
        {mobile && <source media={MOBILE_MEDIA} type="image/jpeg" srcset={mobile.jpg} sizes={mobile.sizes} />}
        <source media={mobile ? DESKTOP_MEDIA : undefined} type="image/avif" srcset={desktop.avif} sizes={desktop.sizes} />
        <source media={mobile ? DESKTOP_MEDIA : undefined} type="image/webp" srcset={desktop.webp} sizes={desktop.sizes} />
        <img
          src={desktop.fallback}
          srcset={desktop.jpg}
          sizes={desktop.sizes}
          alt={altText}
          width={desktop.src.width}
          height={desktop.src.height}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
      {
        hero.heroVideo && (
          <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={poster} aria-hidden="true" data-hero-video>
            <source src={withBase(hero.heroVideo)} type="video/mp4" media="(prefers-reduced-motion: no-preference)" />
          </video>
        )
      }
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <!-- Same size and position as the photo under object-fit: cover, so the note can be placed on the photo. -->
    <div class="hero__frame" aria-hidden="true">
      <p class="hero__note">
        {hero.note}
        <HandArrow class="hero__arrow" />
      </p>
    </div>

    <div class="hero__content">
      <div class="hero__text">
        <h1 id="hero-title">{hero.title}</h1>
        <p class="hero__sub">{hero.sub}</p>
        <a class="button hero__cta" href="#contact">{hero.cta}</a>
      </div>
    </div>
  </div>
</section>

{
  hero.heroVideo && (
    <script>
      // Save-Data: drop the video and keep the poster photo.
      const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      if (video && connection?.saveData) video.remove();
    </script>
  )
}

<style>
  .hero {
    padding: var(--hero-inset) var(--hero-inset) 0;
  }

  .hero__card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(100svh - 2 * var(--hero-inset), 920px);
    border-radius: var(--r-hero);
    overflow: hidden;
    background: var(--ink);
    color: var(--polaroid);
  }

  .hero__media,
  .hero__media picture,
  .hero__media img,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: -2;
  }

  .hero__media img,
  .hero__video {
    object-fit: cover;
    object-position: var(--focal-m);
  }

  /* Top band keeps the nav legible; the bottom-up scrim is the brief's phone scrim. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(46, 33, 24, .42) 0, transparent 120px),
      linear-gradient(to top, rgba(46, 33, 24, .85) 0%, rgba(46, 33, 24, .4) 45%, transparent 70%);
  }

  /* Inside the card the text keeps its own breathing room, capped to the page container. */
  .hero__content {
    position: relative;
    width: 100%;
    padding: 120px max(clamp(20px, 5vw, 72px), (100% - var(--container)) / 2) clamp(24px, 6vw, 72px);
  }

  /*
   * A second, text-anchored scrim. The card scrim is sized to the card, but on short or
   * narrow screens the headline climbs above it onto his white shirt; this one always
   * starts 120px above the first line, so the text never loses contrast.
   */
  .hero__content::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(46, 33, 24, .35) 0, rgba(46, 33, 24, .5) calc(100% - 140px), transparent);
    pointer-events: none;
  }

  .hero__text {
    container-type: inline-size;
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  /* "neighbourhood" is the longest word (≈7.4em in Young Serif); never let it overflow. */
  .hero__text h1 {
    font-size: min(var(--fs-h1), 13.3cqi);
  }

  .hero__sub {
    font-size: clamp(1.1875rem, 1rem + 1vw, var(--fs-lead));
    line-height: 1.45;
    max-width: 30ch;
  }

  .hero__cta {
    margin-top: 6px;
    width: 100%;
  }

  /*
   * The note's frame: the photo's own box. With the photo's aspect ratio and min 100% of
   * the card both ways it is exactly the object-fit: cover box; left/top + translate apply
   * the same focal point as object-position. The note is placed in % of this frame.
   */
  .hero__frame {
    position: absolute;
    left: var(--fx-m);
    top: var(--fy-m);
    z-index: 1;
    min-width: 100%;
    min-height: 100%;
    aspect-ratio: var(--ratio-m);
    transform: translate(calc(-1 * var(--fx-m)), calc(-1 * var(--fy-m)));
    container-type: inline-size;
    pointer-events: none;
  }

  .hero__note {
    position: absolute;
    left: var(--n-m-x);
    top: var(--n-m-y);
    width: max-content;
    max-width: 8.5em;
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--fs-hand);
    line-height: 1.1;
    color: var(--polaroid);
    text-shadow: 0 1px 2px rgba(46, 33, 24, .6), 0 0 16px rgba(46, 33, 24, .6);
  }

  /* A soft shadow under the handwriting, like marker on a busy photo. */
  .hero__note::before {
    content: "";
    position: absolute;
    inset: -45% -28%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(46, 33, 24, .62), rgba(46, 33, 24, .42) 55%, transparent);
    pointer-events: none;
  }

  /* The arrow scales with the photo, so its tip lands in the same spot at every size. */
  .hero__note :global(.hero__arrow) {
    --arrow-stroke: 6;
    position: absolute;
    top: var(--a-m-top);
    bottom: var(--a-m-bottom);
    left: var(--a-m-left);
    right: var(--a-m-right);
    width: 13cqw;
    height: auto;
    transform: var(--a-m-transform);
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .hero__text {
      max-width: 34rem;
    }

    .hero__cta {
      width: auto;
    }
  }

  @media (min-width: 900px) {
    .hero__media img,
    .hero__video {
      object-position: var(--focal-d);
    }

    /* The brief's side scrim, darkest behind the headline and clear by the time it reaches
       Branon. Firmer through the text column so a bright background can't wash out the sub-line. */
    .hero__scrim {
      background:
        linear-gradient(to bottom, rgba(46, 33, 24, .42) 0, transparent 140px),
        linear-gradient(to left, rgba(46, 33, 24, .8) 0%, rgba(46, 33, 24, .62) 42%, rgba(46, 33, 24, .28) 55%, transparent 68%);
    }

    .hero__card--text-left .hero__scrim {
      background:
        linear-gradient(to bottom, rgba(46, 33, 24, .42) 0, transparent 140px),
        linear-gradient(to right, rgba(46, 33, 24, .8) 0%, rgba(46, 33, 24, .62) 36%, rgba(46, 33, 24, .25) 50%, transparent 60%);
    }

    .hero__content {
      padding-top: calc(var(--nav-h) + 80px);
      padding-bottom: clamp(48px, 6vw, 88px);
    }

    .hero__content::before {
      content: none;
    }

    /* Never wider than ~44% of the card, so it stays clear of Branon on narrow desktops. */
    .hero__text {
      max-width: min(30rem, 44%);
      margin-left: auto;
    }

    .hero__card--text-left .hero__text {
      margin-left: 0;
      margin-right: auto;
    }

    .hero__cta {
      width: auto;
    }

    .hero__frame {
      left: var(--fx-d);
      top: var(--fy-d);
      aspect-ratio: var(--ratio-d);
      transform: translate(calc(-1 * var(--fx-d)), calc(-1 * var(--fy-d)));
    }

    .hero__note {
      left: var(--n-d-x);
      top: var(--n-d-y);
      max-width: 7.5em;
    }

    .hero__note :global(.hero__arrow) {
      --arrow-stroke: 4.2;
      top: var(--a-d-top);
      bottom: var(--a-d-bottom);
      left: var(--a-d-left);
      right: var(--a-d-right);
      width: 7.5cqw;
      transform: var(--a-d-transform);
    }
  }
</style>
