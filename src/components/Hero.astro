---
import HandArrow from "./HandArrow.astro";
import { hero, alt } from "../content/site";
import { heroSources, DESKTOP_MEDIA, MOBILE_MEDIA } from "../lib/hero";

const { desktop, mobile, poster } = await heroSources();
const altText = alt[hero.photo.image] ?? "";
const focalMobile = (hero.photoMobile ?? hero.photo).focal ?? "50% 30%";
const { desktop: noteD, tablet: noteT, mobile: noteM } = hero.notePosition;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div
    class="hero__card"
    style={`--focal-d: ${hero.photo.focal ?? "50% 30%"}; --focal-m: ${focalMobile}; --note-d-left: ${noteD.left}; --note-d-top: ${noteD.top}; --note-t-right: ${noteT.right}; --note-t-top: ${noteT.top}; --note-m-right: ${noteM.right}; --note-m-top: ${noteM.top}`}
  >
    <div class="hero__media">
      <picture>
        {mobile && <source media={MOBILE_MEDIA} type="image/avif" srcset={mobile.avif} sizes={mobile.sizes} />}
        {mobile && <source media={MOBILE_MEDIA} type="image/webp" srcset={mobile.webp} sizes={mobile.sizes} />}
        {mobile && <source media={MOBILE_MEDIA} type="image/jpeg" srcset={mobile.jpg} sizes={mobile.sizes} />}
        <source media={mobile ? DESKTOP_MEDIA : undefined} type="image/avif" srcset={desktop.avif} sizes={desktop.sizes} />
        <source media={mobile ? DESKTOP_MEDIA : undefined} type="image/webp" srcset={desktop.webp} sizes={desktop.sizes} />
        <img
          src={desktop.fallback}
          srcset={desktop.jpg}
          sizes={desktop.sizes}
          alt={altText}
          width={desktop.src.width}
          height={desktop.src.height}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
      {
        hero.heroVideo && (
          <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={poster} aria-hidden="true" data-hero-video>
            <source src={hero.heroVideo} type="video/mp4" media="(prefers-reduced-motion: no-preference)" />
          </video>
        )
      }
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <p class="hero__note">
      {hero.note}
      <HandArrow class="hero__arrow" />
    </p>

    <div class="hero__content">
      <div class="hero__text">
        <h1 id="hero-title">{hero.title}</h1>
        <p class="hero__sub">{hero.sub}</p>
        <a class="button hero__cta" href="#contact">{hero.cta}</a>
      </div>
    </div>
  </div>
</section>

{
  hero.heroVideo && (
    <script>
      // Save-Data: drop the video and keep the poster photo.
      const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      if (video && connection?.saveData) video.remove();
    </script>
  )
}

<style>
  .hero {
    padding: var(--hero-inset) var(--hero-inset) 0;
  }

  .hero__card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(100svh - 2 * var(--hero-inset), 920px);
    border-radius: var(--r-hero);
    overflow: hidden;
    background: var(--ink);
    color: var(--polaroid);
  }

  .hero__media,
  .hero__media picture,
  .hero__media img,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: -2;
  }

  .hero__media img,
  .hero__video {
    object-fit: cover;
    object-position: var(--focal-m);
  }

  /* Top band keeps the nav legible; the bottom-up scrim is the brief's phone scrim. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(46, 33, 24, .42) 0, transparent 120px),
      linear-gradient(to top, rgba(46, 33, 24, .85) 0%, rgba(46, 33, 24, .4) 45%, transparent 70%);
  }

  /* Inside the card the text keeps its own breathing room, capped to the page container. */
  .hero__content {
    position: relative;
    width: 100%;
    padding: 120px max(clamp(20px, 5vw, 72px), (100% - var(--container)) / 2) clamp(24px, 6vw, 72px);
  }

  /*
   * A second, text-anchored scrim. The card scrim is sized to the card, but on short or
   * narrow screens the headline climbs above it onto his white shirt; this one always
   * starts 120px above the first line, so the text never loses contrast.
   */
  .hero__content::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(46, 33, 24, .35) 0, rgba(46, 33, 24, .5) calc(100% - 140px), transparent);
    pointer-events: none;
  }

  .hero__text {
    container-type: inline-size;
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  /* "neighbourhood" is the longest word (≈7.4em in Young Serif); never let it overflow. */
  .hero__text h1 {
    font-size: min(var(--fs-h1), 13.3cqi);
  }

  .hero__sub {
    font-size: clamp(1.1875rem, 1rem + 1vw, var(--fs-lead));
    line-height: 1.45;
    max-width: 30ch;
  }

  .hero__cta {
    margin-top: 6px;
    width: 100%;
  }

  /* Handwritten note: top right on phones, the arrow pointing down-left at his head. */
  .hero__note {
    position: absolute;
    top: var(--note-m-top);
    right: var(--note-m-right);
    z-index: 1;
    width: max-content;
    max-width: 8.5em;
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--fs-hand);
    line-height: 1.1;
    color: var(--polaroid);
    text-shadow: 0 1px 2px rgba(46, 33, 24, .6), 0 0 16px rgba(46, 33, 24, .6);
  }

  /* A soft shadow under the handwriting, like marker on a busy photo. */
  .hero__note::before {
    content: "";
    position: absolute;
    inset: -45% -28%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(46, 33, 24, .62), rgba(46, 33, 24, .42) 55%, transparent);
    pointer-events: none;
  }

  .hero__note :global(.hero__arrow) {
    --arrow-stroke: 6;
    position: absolute;
    top: calc(100% + 2px);
    right: 52%;
    width: 64px;
    height: auto;
    transform: rotate(180deg);
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .hero__text {
      max-width: 34rem;
    }

    .hero__note {
      top: var(--note-t-top);
      right: var(--note-t-right);
    }

    .hero__cta {
      width: auto;
    }
  }

  @media (min-width: 900px) {
    .hero__media img,
    .hero__video {
      object-position: var(--focal-d);
    }

    /* The brief's side scrim, held a little firmer through the text column so the
       bright wall between the curtains can't wash out the sub-line. */
    .hero__scrim {
      background:
        linear-gradient(to bottom, rgba(46, 33, 24, .42) 0, transparent 140px),
        linear-gradient(to left, rgba(46, 33, 24, .8) 0%, rgba(46, 33, 24, .62) 42%, rgba(46, 33, 24, .28) 55%, transparent 68%);
    }

    .hero__content {
      padding-top: calc(var(--nav-h) + 80px);
      padding-bottom: clamp(48px, 6vw, 88px);
    }

    .hero__content::before {
      content: none;
    }

    .hero__text {
      max-width: 30rem;
      margin-left: auto;
    }

    .hero__cta {
      width: auto;
    }

    /* Upper left, beside his face; the arrow flicks up and right at his head. */
    .hero__note {
      top: var(--note-d-top);
      left: var(--note-d-left);
      right: auto;
      max-width: 7.5em;
    }

    .hero__note :global(.hero__arrow) {
      --arrow-stroke: 4.2;
      top: auto;
      right: auto;
      bottom: calc(100% + 2px);
      left: 38%;
      width: 96px;
      transform: rotate(4deg);
    }
  }
</style>
