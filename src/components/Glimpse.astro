---
/**
 * "A glimpse into my events": the bento from the original sketch.
 * Every tile comes from `glimpse.tiles` in site.ts.
 */
import { Picture, getImage } from "astro:assets";
import Polaroid from "./Polaroid.astro";
import { glimpse, images, alt, type Tile } from "../content/site";
import { coverFactor } from "../lib/sizes";
import { withBase } from "../lib/paths";

const WIDTHS = [480, 800, 1200, 1600, 2000];

/** Approximate box per breakpoint for each area, so `sizes` asks for the drawn width. */
const boxes: Record<Tile["area"], { desktop: [string, string, number]; tablet: [string, number]; mobile: number }> = {
  a: { desktop: ["288px", "calc(25vw - 30px)", 0.55], tablet: ["calc(46vw - 8px)", 0.64], mobile: 0.8 },
  b: { desktop: ["592px", "calc(50vw - 44px)", 2.35], tablet: ["92vw", 2.7], mobile: 4 / 3 },
  c: { desktop: ["288px", "calc(25vw - 30px)", 1.2], tablet: ["calc(46vw - 8px)", 1.3], mobile: 4 / 3 },
  d: { desktop: ["288px", "calc(25vw - 30px)", 1.2], tablet: ["calc(46vw - 8px)", 1.3], mobile: 4 / 3 },
  e: { desktop: ["288px", "calc(25vw - 30px)", 0.55], tablet: ["92vw", 1.31], mobile: 0.8 },
  f: { desktop: ["592px", "calc(50vw - 44px)", 2.35], tablet: ["92vw", 2.7], mobile: 4 / 3 },
  g: { desktop: ["592px", "calc(50vw - 44px)", 2.35], tablet: ["92vw", 2.7], mobile: 4 / 3 },
};

function tileSizes(area: Tile["area"], imageAspect: number, zoom = 1) {
  const box = boxes[area];
  const scale = (len: string, aspect: number) => {
    const f = coverFactor(imageAspect, aspect, zoom);
    return f === 1 ? len : `calc(${len} * ${f.toFixed(3)})`;
  };
  return [
    `(min-width: 1296px) ${scale(box.desktop[0], box.desktop[2])}`,
    `(min-width: 900px) ${scale(box.desktop[1], box.desktop[2])}`,
    `(min-width: 600px) ${scale(box.tablet[0], box.tablet[1])}`,
    scale("calc(100vw - 40px)", box.mobile),
  ].join(", ");
}

/** On phones the bento is one column; never show two text tiles in a row. */
function mobileOrder(tiles: Tile[]) {
  const queue = [...tiles];
  const out: Tile[] = [];
  while (queue.length) {
    const prevIsText = out.at(-1)?.kind === "text";
    const index = prevIsText ? queue.findIndex((t) => t.kind !== "text") : 0;
    out.push(...queue.splice(index === -1 ? 0 : index, 1));
  }
  return new Map(out.map((t, i) => [t.area, i]));
}
const order = mobileOrder(glimpse.tiles);

/** Full-size versions for the lightbox (and the plain link when JS is off). */
async function fullSize(key: string) {
  const src = images[key];
  const aspect = src.width / src.height;
  const [avif, jpg] = await Promise.all([
    getImage({ src, format: "avif", widths: [800, 1200, 1600, 2000] }),
    getImage({ src, format: "jpg", width: 2000 }),
  ]);
  // The dialog fits the photo inside the viewport: height-bound on wide screens, width-bound on narrow.
  const ratio = `${Math.round(aspect * 1000)}/1000`;
  const sizes = `(min-aspect-ratio: ${ratio}) calc((100vh - 90px) * ${aspect.toFixed(3)}), calc(100vw - 44px)`;
  return { avif: avif.srcSet.attribute, jpg: jpg.src, sizes };
}

const tiles = await Promise.all(
  glimpse.tiles.map(async (tile) => {
    if (tile.kind === "photo") return { tile, full: await fullSize(tile.photo.image) };
    if (tile.kind === "video") return { tile, full: await fullSize(tile.poster.image) };
    return { tile, full: null };
  }),
);
---

<section class="glimpse section" aria-labelledby="glimpse-title">
  <div class="container">
    <div class="section-head">
      <h2 id="glimpse-title">{glimpse.title}</h2>
      <p class="lead">{glimpse.lead}</p>
    </div>

    <div class="bento">
      {
        tiles.map(({ tile, full }) => {
          const style = `--m-order: ${order.get(tile.area)}`;
          if (tile.kind === "photo" && full) {
            const img = images[tile.photo.image];
            return (
              <a
                class={`tile tile--photo tile--${tile.area}`}
                style={`${style}; --focal: ${tile.photo.focal ?? "50% 50%"}; --zoom: ${tile.photo.zoom ?? 1}`}
                href={full.jpg}
                data-lightbox
                data-full-avif={full.avif}
                data-full-sizes={full.sizes}
                data-full-alt={alt[tile.photo.image]}
              >
                <Picture
                  src={img}
                  alt={alt[tile.photo.image]}
                  formats={["avif", "webp"]}
                  widths={WIDTHS}
                  sizes={tileSizes(tile.area, img.width / img.height, tile.photo.zoom)}
                  loading="lazy"
                  decoding="async"
                />
                <span class="visually-hidden">(view larger)</span>
              </a>
            );
          }
          if (tile.kind === "video" && full) {
            const img = images[tile.poster.image];
            return (
              <a
                class={`tile tile--photo tile--video tile--${tile.area}`}
                style={`${style}; --focal: ${tile.poster.focal ?? "50% 50%"}`}
                href={withBase(tile.src)}
                data-lightbox
                data-video={withBase(tile.src)}
                aria-label={tile.label}
              >
                <Picture
                  src={img}
                  alt=""
                  formats={["avif", "webp"]}
                  widths={WIDTHS}
                  sizes={tileSizes(tile.area, img.width / img.height)}
                  loading="lazy"
                  decoding="async"
                />
                <span class="play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d="M8.5 6.2c3.3 1.8 6.4 3.7 9.4 5.8-3 2-6.1 3.9-9.3 5.8-.2-3.9-.3-7.8-.1-11.6z" />
                  </svg>
                </span>
              </a>
            );
          }
          if (tile.kind === "polaroid") {
            const img = images[tile.photo.image];
            return (
              <div class={`tile tile--polaroid tile--${tile.area}`} style={style}>
                <Polaroid
                  variant="square"
                  image={img}
                  alt={alt[tile.photo.image]}
                  focal={tile.photo.focal}
                  zoom={tile.photo.zoom}
                  tilt={tile.tilt}
                  frameSizes="(min-width: 900px) 200px, (min-width: 600px) 240px, 70vw"
                />
              </div>
            );
          }
          if (tile.kind === "text") {
            return (
              <div class={`tile tile--text tile--${tile.tone} tile--${tile.area}`} style={style}>
                {/* Decorative marker scribble: drawn from a data attribute so it stays out of the text. */}
                {tile.doodle && <span class="tile__doodle" aria-hidden="true" data-doodle={tile.doodle} />}
                <h3>{tile.title}</h3>
                <p>{tile.body}</p>
              </div>
            );
          }
        })
      }
    </div>
  </div>

  <dialog class="lightbox" aria-label="Photo" data-lightbox-dialog>
    <form method="dialog" class="lightbox__bar">
      <button class="button button--small lightbox__close" value="close">Close</button>
    </form>
    <div class="lightbox__stage">
      <picture hidden>
        <source type="image/avif" />
        <img alt="" />
      </picture>
      <video controls playsinline hidden></video>
    </div>
  </dialog>
</section>

<script>
  import "../scripts/lightbox";
</script>

<style>
  .bento {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  .tile {
    position: relative;
    order: var(--m-order);
    border-radius: var(--r-tile);
    overflow: hidden;
  }

  /* Photo tiles: no captions, borders or shadows; a hairline for definition on linen. */
  .tile--photo {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--paper-deep);
    cursor: zoom-in;
  }

  .tile--photo::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(46, 33, 24, .06);
    pointer-events: none;
  }

  .tile--a.tile--photo,
  .tile--e.tile--photo {
    aspect-ratio: 4 / 5;
  }

  .tile--photo :global(picture),
  .tile--photo :global(img) {
    width: 100%;
    height: 100%;
  }

  .tile--photo :global(img) {
    object-fit: cover;
    object-position: var(--focal);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--focal);
  }

  .tile--photo:focus-visible {
    outline-offset: 4px;
  }

  .tile--video {
    cursor: pointer;
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--marigold);
    transform: translate(-50%, -50%);
    transition: background-color 160ms ease;
  }

  .play svg {
    fill: var(--ink);
  }

  .tile--video:hover .play {
    background: var(--marigold-deep);
  }

  .tile--text {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    min-height: 200px;
    padding: 28px;
    color: var(--ink);
  }

  .tile--sage {
    background: var(--sage);
  }

  .tile--paper {
    background: var(--paper-deep);
  }

  .tile--text h3 {
    font-size: var(--fs-h3);
  }

  .tile--text p {
    font-size: var(--fs-body);
    line-height: 1.5;
    max-width: 34ch;
  }

  .tile__doodle::before {
    content: attr(data-doodle);
  }

  .tile__doodle {
    position: absolute;
    top: 18px;
    right: 22px;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--marigold);
    transform: rotate(-6deg);
  }

  .tile--polaroid {
    display: grid;
    place-items: center;
    padding: 16px 0;
    overflow: visible;
  }

  .tile--polaroid :global(.polaroid) {
    width: min(70vw, 260px);
  }

  @media (min-width: 600px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Rows can grow if a text tile's copy needs more room; photos never push them. */
      grid-auto-rows: minmax(clamp(200px, 34vw, 280px), auto);
      grid-auto-flow: dense;
    }

    .tile--photo :global(picture) {
      position: absolute;
      inset: 0;
    }

    .tile {
      order: 0;
    }

    .tile--photo,
    .tile--a.tile--photo,
    .tile--e.tile--photo {
      aspect-ratio: auto;
    }

    .tile--a {
      grid-row: span 2;
    }

    .tile--b,
    .tile--f,
    .tile--g {
      grid-column: span 2;
    }

    /* Two columns leave no partner for a tall E, so it takes the full width. */
    .tile--e {
      grid-column: span 2;
      grid-row: span 2;
    }

    .tile--text {
      min-height: 0;
    }

    .tile--polaroid {
      contain: size;
    }

    .tile--polaroid :global(.polaroid) {
      width: auto;
      height: calc(100% - 8px);
    }
  }

  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(clamp(180px, 18vw, 240px), auto);
      grid-template-areas:
        "a b b e"
        "a c d e"
        "f f g g";
    }

    .tile--a { grid-area: a; }
    .tile--b { grid-area: b; }
    .tile--c { grid-area: c; }
    .tile--d { grid-area: d; }
    .tile--e { grid-area: e; }
    .tile--f { grid-area: f; }
    .tile--g { grid-area: g; }

    .tile--text {
      padding: 24px 26px;
    }

    /* The two small tiles are narrow until ~1150px; ease the title down to fit. */
    .tile--c h3,
    .tile--d h3 {
      font-size: clamp(1.375rem, 2.6vw, var(--fs-h3));
    }
  }

  @media (min-width: 1100px) {
    .tile--text {
      padding: 28px;
    }
  }

  /* Lightbox: the only modal on the site. */
  .lightbox {
    width: min(100vw - 24px, 1400px);
    max-width: none;
    height: min(100dvh - 24px, 1000px);
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: var(--r-tile);
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .lightbox::backdrop {
    background: rgba(46, 33, 24, .82);
  }

  .lightbox__bar {
    display: flex;
    justify-content: flex-end;
    padding: 10px;
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 10px 10px;
  }

  .lightbox__stage picture,
  .lightbox__stage video {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .lightbox__stage img,
  .lightbox__stage video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lightbox__stage [hidden] {
    display: none;
  }
</style>
