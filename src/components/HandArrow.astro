---
/**
 * A hand-drawn marker arrow: one wobbly stroke and a two-flick head, in marigold.
 * Drawn left-bottom → right-top; rotate it with CSS to point elsewhere.
 * It draws itself on load (stroke-dashoffset); reduced motion shows it finished.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["hand-arrow", className]} viewBox="0 0 132 96" fill="none" aria-hidden="true" focusable="false">
  <path
    pathLength="1"
    d="M6 86c9-3 17-9 25-14 9-6 15-13 24-19 8-6 18-9 26-15 9-7 18-14 27-21 4-3 9-6 13-9 M102 9c6-1 12-2 19-1 -1 6-2 13-5 19"
  ></path>
</svg>

<style>
  .hand-arrow {
    overflow: visible;
  }

  .hand-arrow path {
    stroke: var(--marigold);
    /* viewBox units; set --arrow-stroke so it lands at ~3px for the rendered size */
    stroke-width: var(--arrow-stroke, 3);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-arrow 900ms cubic-bezier(.5, .1, .3, 1) 400ms forwards;
  }

  @keyframes draw-arrow {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hand-arrow path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
