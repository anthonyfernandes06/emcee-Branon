---
/**
 * The page's core device: an instant-film print.
 *
 * mini   portrait, like Instax Mini (frame 54:86, window 46:62)
 * square like Instax Square (frame 72:86, window 1:1)
 * note   square frame, window holds a short quote (slot) instead of a photo
 * empty  mini frame with an undeveloped window. It never develops; that's the joke.
 *
 * Photos start washed out and develop once, the first time they scroll into view
 * (see src/scripts/develop.ts). Without JS, or with reduced motion, they show in full colour.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Tape from "./Tape.astro";
import { coverFactor, scaleSizes } from "../lib/sizes";

interface Props {
  variant: "mini" | "square" | "note" | "empty";
  image?: ImageMetadata;
  alt?: string;
  /** object-position, e.g. "45% 35%" */
  focal?: string;
  /** optional extra crop around `focal` (1 = none) */
  zoom?: number;
  caption?: string;
  /** degrees, -5 to 5 (8 for the back card in Contact) */
  tilt?: number;
  tape?: "top" | "corner" | null;
  develop?: boolean;
  /** The frame's rendered width, as a `sizes` string. Used to pick the photo file. */
  frameSizes?: string;
  /** Window fill for the note variant */
  tone?: "sage" | "paper";
  class?: string;
  /** Stagger hint is handled in JS; this only marks purely decorative frames. */
  decorative?: boolean;
}

const {
  variant,
  image,
  alt = "",
  focal = "50% 50%",
  zoom = 1,
  caption,
  tilt = 0,
  tape = null,
  develop = variant !== "empty" && variant !== "note",
  frameSizes = "300px",
  tone = "sage",
  class: className,
  decorative = false,
} = Astro.props;

const isPhoto = (variant === "mini" || variant === "square") && image;
const windowAspect = variant === "mini" || variant === "empty" ? 46 / 62 : 1;
const sizes = image
  ? scaleSizes(frameSizes, 0.86 * coverFactor(image.width / image.height, windowAspect, zoom))
  : undefined;
const shouldDevelop = Boolean(isPhoto && develop);
---

<figure
  class:list={[
    "polaroid",
    `polaroid--${variant === "empty" ? "mini" : variant === "note" ? "square" : variant}`,
    `polaroid--is-${variant}`,
    { "is-undeveloped": shouldDevelop },
    className,
  ]}
  style={`--tilt: ${tilt}deg`}
  data-develop={shouldDevelop ? "" : undefined}
  aria-hidden={decorative ? "true" : undefined}
>
  {tape && <Tape position={tape} seed={caption ?? variant} />}
  <div
    class:list={["polaroid__window", { "polaroid__window--paper": tone === "paper" }]}
    style={isPhoto ? `--focal: ${focal}; --zoom: ${zoom}` : undefined}
  >
    {
      isPhoto && (
        <Picture
          src={image}
          alt={alt}
          formats={["avif", "webp"]}
          widths={[480, 800, 1200, 1600, 2000]}
          sizes={sizes}
          loading="lazy"
          decoding="async"
          class="polaroid__photo"
        />
      )
    }
    {variant === "note" && <div class="polaroid__note"><slot /></div>}
  </div>
  {caption && <figcaption class="polaroid__caption">{caption}</figcaption>}
</figure>

<style>
  .polaroid {
    --pad: 7%;
    position: relative;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--pad) var(--pad) 0;
    background: var(--polaroid);
    border-radius: var(--r-polaroid);
    box-shadow: var(--shadow-polaroid);
    transform: rotate(var(--tilt));
  }

  .polaroid--mini {
    aspect-ratio: 54 / 86;
  }

  .polaroid--square {
    aspect-ratio: 72 / 86;
  }

  .polaroid__window {
    position: relative;
    overflow: hidden;
    flex: none;
    background: var(--sage-pale);
    aspect-ratio: 1 / 1;
  }

  .polaroid--mini .polaroid__window {
    aspect-ratio: 46 / 62;
  }

  .polaroid__window--paper {
    background: var(--paper-deep);
  }

  .polaroid__window :global(picture) {
    width: 100%;
    height: 100%;
  }

  .polaroid__window :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--focal);
    transition: filter 1.8s var(--ease-develop) var(--develop-delay, 0ms);
  }

  /* Film grain on the print */
  .polaroid__window::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 220px 220px;
    opacity: .08;
    mix-blend-mode: multiply;
  }

  /* The milky layer that clears as the photo develops */
  .polaroid__window::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: #EDE6D6;
    opacity: 0;
    transition: opacity 1.2s var(--ease-develop) var(--develop-delay, 0ms);
  }

  :global(.can-develop) .polaroid.is-undeveloped .polaroid__window :global(img) {
    filter: saturate(0) contrast(.7) brightness(1.3) sepia(.25);
  }

  :global(.can-develop) .polaroid.is-undeveloped .polaroid__window::after {
    opacity: .85;
  }

  /* Empty: an undeveloped print that never comes through. */
  .polaroid--is-empty .polaroid__window {
    background:
      linear-gradient(118deg, transparent 32%, rgba(255, 253, 247, .38) 47%, transparent 62%),
      var(--sage-pale);
  }

  .polaroid__note {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 9%;
  }

  .polaroid__caption {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 2% 4% 3%;
    font-family: var(--font-hand);
    font-size: clamp(0.9375rem, 8.4cqi, var(--fs-hand));
    line-height: 1.15;
    color: var(--ink);
    text-align: center;
    text-wrap: balance;
    transform: rotate(-1deg);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .polaroid {
      transition: transform 220ms ease;
    }

    .polaroid:hover {
      transform: translateY(-4px) rotate(calc(var(--tilt) * .3));
    }
  }
</style>
