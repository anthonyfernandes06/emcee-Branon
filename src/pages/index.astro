---
import "@fontsource/young-serif/400.css";
import "@fontsource/kalam/400.css";
import "@fontsource/kalam/700.css";
import "@fontsource/hind/400.css";
import "@fontsource/hind/500.css";
import "@fontsource/hind/600.css";
import "../styles/global.css";

import youngSerif from "@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url";
import kalamBold from "@fontsource/kalam/files/kalam-latin-700-normal.woff2?url";
import hind400 from "@fontsource/hind/files/hind-latin-400-normal.woff2?url";

import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Glimpse from "../components/Glimpse.astro";
import KindWords from "../components/KindWords.astro";
import WhatIHost from "../components/WhatIHost.astro";
import Contact from "../components/Contact.astro";

import { meta, contact, isPlaceholder, serviceArea, languages, footer } from "../content/site";
import { heroSources, DESKTOP_MEDIA, MOBILE_MEDIA } from "../lib/hero";
import { withBase } from "../lib/paths";

const site = Astro.site;
const absolute = (path: string) => (site ? new URL(withBase(path), site).href : withBase(path));
const home = site ? absolute("/") : undefined;
const { desktop, mobile } = await heroSources();

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Branon",
  jobTitle: meta.jobTitle,
  description: meta.description,
  knowsLanguage: languages,
  areaServed: serviceArea.map((name) => ({ "@type": "City", name })),
  ...(home ? { url: home, image: absolute(meta.ogImage) } : {}),
  // Contact details stay out until the placeholders in site.ts are filled.
  ...(isPlaceholder(contact.email) ? {} : { email: `mailto:${contact.email}` }),
  ...(isPlaceholder(contact.phone) ? {} : { telephone: contact.phone.replace(/\s+/g, "") }),
};
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {home && <link rel="canonical" href={home} />}
    <meta name="theme-color" content="#F1E6D2" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={absolute(meta.ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Branon on the mic, with the words: Your friendly neighbourhood Mangalorean host." />
    <meta property="og:locale" content="en_IN" />
    {home && <meta property="og:url" content={home} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={absolute(meta.ogImage)} />

    <!-- The hero photo and the fonts it sits under -->
    {
      mobile && (
        <link rel="preload" as="image" type="image/avif" media={MOBILE_MEDIA} imagesrcset={mobile.avif} imagesizes={mobile.sizes} fetchpriority="high" />
      )
    }
    <link rel="preload" as="image" type="image/avif" media={mobile ? DESKTOP_MEDIA : undefined} imagesrcset={desktop.avif} imagesizes={desktop.sizes} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href={youngSerif} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={hind400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={kalamBold} crossorigin />

    <script is:inline>
      // Enhancements switch on only when JS runs: the clear nav over the hero and,
      // unless reduced motion is on, the Polaroid develop effect.
      document.documentElement.classList.add("js");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("can-develop");
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#contact">Skip to contact</a>
    <Nav />
    <main>
      <Hero />
      <About />
      <Glimpse />
      <KindWords />
      <WhatIHost />
      <Contact />
    </main>
    <footer class="site-footer night">
      <div class="site-footer__inner container">
        <p>© {year} Branon. {footer.line}</p>
        <p class="site-footer__credit">
          {footer.credit.before}{" "}
          <a href={footer.credit.url} target="_blank" rel="noopener noreferrer">
            {footer.credit.name}<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </footer>
    <script>
      import "../scripts/develop";
    </script>
  </body>
</html>

<style>
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 24px 32px;
    border-top: 1px solid rgba(241, 230, 210, .15);
    font-size: var(--fs-cap);
    color: rgba(241, 230, 210, .7);
  }

  .site-footer__inner p {
    max-width: none;
  }

  .site-footer__credit {
    font-family: var(--font-hand);
    font-size: 1.0625rem;
  }

  .site-footer__credit a {
    color: var(--on-night);
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-underline-offset: 3px;
    transition: color 160ms ease;
  }

  .site-footer__credit a:hover {
    color: var(--marigold);
  }
</style>
